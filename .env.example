# Server-side Gemini key (recommended). On Vercel: Project Settings → Environment Variables → GEMINI_API_KEY.
# Locally: put it in .env.local (gitignored). It is used only by the /api/gemini server proxy and never reaches the browser.
GEMINI_API_KEY=

# Optional, NOT recommended: a browser-side default key. VITE_ variables are PUBLIC in the built bundle.
VITE_GEMINI_API_KEY=
